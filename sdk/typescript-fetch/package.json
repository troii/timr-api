{
  "name": "timr-api",
  "version": "1.1.0",
  "description": "Official TypeScript client for the timr API",
  "author": "troii Software GmbH",
  "homepage": "https://developer.timr.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/troii/timr-api.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsdown",
    "test": "npm run build && npm run test:types && node --test tests/*.test.cjs",
    "test:types": "tsc --ignoreConfig --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext --lib es2022,dom tests/api-types.ts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
