<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Timr.Api.Test</AssemblyName>
    <RootNamespace>Timr.Api.Test</RootNamespace>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="WireMock.Net" Version="2.19.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timr.Api\Timr.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\test-fixtures\user.json" Link="test-fixtures\user.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
